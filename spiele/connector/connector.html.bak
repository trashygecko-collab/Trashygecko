<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TrashyGecko Connector</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#10121b;color:#eee;font:16px Arial;padding:16px}
main{max-width:760px;margin:auto}
h1{color:#4df5c2;text-align:center;font-size:clamp(22px,5vw,32px)}
h2{font-size:20px;margin-top:0}
section{background:#1c2030;border:1px solid #394158;border-radius:12px;padding:18px;margin:16px 0}
button,input,select{padding:12px;border-radius:7px;border:1px solid #59647c;font-size:16px}
button{background:#4df5c2;color:#10121b;font-weight:bold;cursor:pointer}
button:hover{filter:brightness(1.1)}
input,select{background:#10121b;color:white;max-width:100%;min-width:0}
.line{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}
.line input{flex:1}
#addresses p{overflow-wrap:anywhere;margin:7px 0}
#chat{height:230px;overflow:auto;background:#10121b;padding:10px;border-radius:8px}
.msg{padding:6px 0;border-bottom:1px solid #30364a;overflow-wrap:anywhere}
small{color:#9da8bd}
.code{font-size:28px;color:#4df5c2;font-weight:bold}
.room{display:flex;justify-content:space-between;align-items:center;gap:12px;background:#10121b;border:1px solid #394158;border-radius:9px;padding:12px;margin:9px 0}
.room-info{min-width:0}
.room-code{font-size:20px;font-weight:bold;color:#4df5c2}
.room-meta{font-size:13px;color:#aab3c7;margin-top:5px}
.empty{color:#aab3c7;padding:12px 0}
#roomstatus{color:#4df5c2}
#qrwrap{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:14px}
#qrcode{width:176px;height:176px;background:white;padding:8px;border-radius:8px;image-rendering:pixelated}
#qrhint{color:#aab3c7;font-size:14px;max-width:240px}
@media(max-width:430px){
 body{padding:9px}
 section{padding:13px}
 .room{align-items:flex-start;flex-direction:column}
 .room button{width:100%}
}
.chat-player{
 color:#aab3c7;
 margin:-5px 0 12px;
 font-size:14px;
}
.chat-player strong{color:#4df5c2}
#chat{
 height:300px;
 min-height:180px;
 overflow-y:auto;
 background:#10121b;
 padding:12px;
 border:1px solid #30364a;
 border-radius:9px;
}
.chat-compose{
 display:flex;
 flex-direction:column;
 gap:9px;
 margin-top:12px;
}
.chat-compose select{
 width:100%;
 padding:12px;
 border-radius:7px;
 border:1px solid #59647c;
 background:#10121b;
 color:white;
 font-size:16px;
}
.chat-send-row{
 display:flex;
 gap:8px;
 width:100%;
}
.chat-send-row input{
 flex:1;
 width:0;
 min-width:0;
}
.chat-send-row button{
 flex:0 0 auto;
 min-width:88px;
}
@media(max-width:430px){
 body{padding:8px}
 section{padding:12px}
 #chat{height:260px}
 .chat-send-row{display:flex;flex-direction:row}
 .chat-send-row input{flex:1;min-width:0}
 .chat-send-row button{width:auto}
}

#game-status{line-height:1.45;margin-top:12px}
.game-player{display:flex;align-items:center;justify-content:space-between;gap:10px;background:#10121b;border:1px solid #394158;border-radius:9px;padding:10px 12px;margin:8px 0}
.game-player span{min-width:0;overflow-wrap:anywhere}
.game-player button{flex:0 0 auto}
.game-invite-controls{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
.game-invite-controls select{flex:1;min-width:150px}
.game-invite-controls button{flex:0 0 auto}
.game-invite{border:1px solid #4df5c2;border-radius:9px;padding:12px;margin:10px 0;background:#192a2b}
.game-invite strong{color:#4df5c2}
.game-invite-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.game-invite-actions button{flex:1;min-width:110px}
.chat-name-btn{background:none;border:none;padding:0;font:inherit;font-weight:bold;color:#4df5c2;cursor:pointer;text-decoration:none}
.chat-name-btn:hover{text-decoration:underline;filter:brightness(1.2)}
.mute-popover{margin-top:4px;padding:6px;background:#252b40;border:1px solid #4df5c2;border-radius:6px;display:flex;align-items:center;gap:6px;font-size:13px;flex-wrap:wrap}
.mute-popover button{padding:4px 8px;font-size:12px;border-radius:4px}
.mute-list-tag{color:#ffd36a;font-size:12px;margin-top:4px}
</style>
</head>
<body>
<main>
<h1>TRASHYGECKO CONNECTOR</h1>

<section>
<h2>Lokale Verbindung</h2>
<p>Diese Adresse funktioniert für Geräte im selben WLAN oder LAN:</p>
<div id="addresses">Adressen werden gesucht …</div>
<button onclick="copyAddress()">Adresse kopieren</button>
<div id="qrwrap"><img id="qrcode" alt="QR-Code für die lokale Verbindung" hidden><div id="qrhint">QR-Code wird vorbereitet …</div></div>
</section>

<section>
<h2>Dein Spielername</h2>
<input id="player" placeholder="Dein Name" maxlength="24">
</section>

<section>
<h2>Spielraum erstellen</h2>
<button onclick="createRoom()">Neuen Spielraum erstellen</button>
<p id="created"></p>
</section>

<section>
<h2>Offene Spielräume</h2>
<div id="rooms"><div class="empty">Spielräume werden gesucht …</div></div>
</section>

<input id="room" type="hidden">
<p id="roomstatus" hidden></p>

<section id="chatbox" hidden>
<h2>Chat</h2>
<div class="chat-player">Dein Spielername: <strong id="chatplayer">Spieler</strong></div>
<div id="muteOverview" class="mute-list-tag" hidden></div>
<div id="chat"></div>
<div id="game-status" class="empty">Wähle einen Spieler aus und lade ihn zu einem Spiel ein.</div>
<div id="gameplayers"></div>
<div class="chat-compose">
<select id="recipient" aria-label="Nachrichtenempfänger">
<option value="">An alle</option>
</select>
<div class="chat-send-row">
<input id="message" placeholder="Nachricht schreiben" maxlength="1000">
<button onclick="send()">Senden</button>
</div>
</div>
</section>

<section><small>TrashyGecko Connector · Lokales Netzwerk · Keine Internetverbindung nötig</small></section>
</main>

<script>
let activeRoom="", address="", sessionID="", isRoomOwner=false, selectedMuteSender=null, selectedMenuSender=null;
let currentPlayersList=[];
try {
 sessionID=sessionStorage.getItem("tg-player-id")||"";
 if(!sessionID){
  sessionID=(crypto.randomUUID?crypto.randomUUID():String(Date.now())+Math.random());
  sessionStorage.setItem("tg-player-id",sessionID);
 }
} catch(e) {
 sessionID=String(Date.now())+Math.random();
}

function playerName(){
 return document.getElementById("player").value.trim()||"Spieler";
}

async function loadStatus(){
 try{
  const s=await fetch("/api/status").then(r=>r.json());
  const chosen=s.ip||(s.ips&&s.ips[0])||"";
  const box=document.getElementById("addresses");
  box.innerHTML="";

  if(chosen){
   address="http://"+chosen+":"+s.port+"/connector";
   const p=document.createElement("p");
   p.textContent=address;
   box.appendChild(p);

   const qr=document.getElementById("qrcode");
   if(qr){
    qr.src="/api/qr?ip="+encodeURIComponent(chosen);
    qr.hidden=false;
   }
   const hint=document.getElementById("qrhint");
   if(hint)hint.textContent="Mit der Handykamera scannen. Das Handy muss im selben WLAN sein.";
  }else{
   address="http://localhost:"+s.port+"/connector";
   box.textContent="Keine passende Netzwerkadresse gefunden.";
   const hint=document.getElementById("qrhint");
   if(hint)hint.textContent="Keine lokale Netzwerkadresse gefunden.";
  }
 }catch(e){
  document.getElementById("addresses").textContent="Adressen konnten nicht geladen werden.";
  const hint=document.getElementById("qrhint");
  if(hint)hint.textContent="QR-Code konnte nicht geladen werden.";
 }
}

async function copyAddress(){
 try{
  await navigator.clipboard.writeText(address);
  alert("Adresse kopiert!");
 }catch(e){
  prompt("Adresse kopieren:",address);
 }
}

async function refreshRooms(){
 try{
  const list=await fetch("/api/rooms").then(r=>{
   if(!r.ok)throw Error();
   return r.json();
  });
  const box=document.getElementById("rooms");
  box.innerHTML="";
  if(!list.length){
   box.innerHTML='<div class="empty">Noch keine offenen Spielräume. Erstelle einfach einen neuen!</div>';
   return;
  }
  list.forEach(room=>{
    const row=document.createElement("div");
    row.className="room";
    const info=document.createElement("div");
    info.className="room-info";
    const title=document.createElement("div");
    title.className="room-code";
    title.textContent=room.name || room.code;
    const meta=document.createElement("div");
    meta.className="room-meta";
    const statusPart = room.status ? room.status + (room.game ? " ("+room.game+")" : "") + " • " : "";
    meta.textContent = statusPart + room.players + " Spieler · Erstellt um " + room.created + " Uhr";
    info.append(title,meta);
    const btn=document.createElement("button");
    btn.textContent=activeRoom===room.code?"Verbunden":"Beitreten";
    btn.disabled=activeRoom===room.code;
    btn.onclick=()=>{document.getElementById("room").value=room.code;join();};
    row.append(info,btn);
    box.appendChild(row);
  });
 }catch(e){
  document.getElementById("rooms").textContent="Raumliste momentan nicht erreichbar.";
 }
}

async function createRoom(){
 try{
  const r=await fetch("/api/rooms",{
   method:"POST",
   headers:{"Content-Type":"application/json"},
   body:JSON.stringify({id:sessionID,name:playerName()})
  }).then(x=>x.json());
  const displayName = r.name || r.code;
  document.getElementById("created").innerHTML='<span class="code">'+displayName+'</span>';
  document.getElementById("room").value=r.code;
  await join(displayName);
  refreshRooms();
 }catch(e){
  document.getElementById("created").textContent="Spielraum konnte nicht erstellt werden.";
 }
}

async function join(roomDisplayName){
 const code=document.getElementById("room").value.trim().toUpperCase();
 if(!code)return;
 try{
  const p=await fetch("/api/presence",{
   method:"POST",headers:{"Content-Type":"application/json"},
   body:JSON.stringify({room:code,id:sessionID,name:playerName()})
  });
  if(!p.ok)throw Error(p.status===404?"Spielraum nicht gefunden.":"Beitritt fehlgeschlagen.");
  activeRoom=code;
  document.getElementById("roomstatus").textContent="Verbunden mit "+(roomDisplayName||code);
  document.getElementById("chatbox").hidden=false;
  document.getElementById("chatplayer").textContent=playerName();
  await refresh();
  refreshRooms();
  await refreshPlayers();
  loadMutes();
 }catch(e){
  document.getElementById("roomstatus").textContent=e.message;
 }
}

async function heartbeat(){
 if(!activeRoom)return;
 document.getElementById("chatplayer").textContent=playerName();
 try{
  await fetch("/api/presence",{
   method:"POST",headers:{"Content-Type":"application/json"},
   body:JSON.stringify({room:activeRoom,id:sessionID,name:playerName()})
  });
 }catch(e){}
}

async function refreshPlayers(){
 if(!activeRoom)return;
 try{
  const res=await fetch("/api/players?room="+encodeURIComponent(activeRoom));
  const ownerHeader=res.headers.get("X-Room-Owner");
  if(ownerHeader){
   isRoomOwner = (ownerHeader === sessionID);
  }
  const list=await res.json();
  const sel=document.getElementById("recipient"),old=sel.value;
  sel.innerHTML='<option value="">An alle</option>';
  list.forEach(p=>{
   if(p.id===sessionID)return;
   const o=document.createElement("option");
   o.value=p.id;
   o.textContent="Flüstern an "+p.name;
   sel.appendChild(o);
  });
  if([...sel.options].some(o=>o.value===old))sel.value=old;
  await refreshGames(list);
 }catch(e){}
}

async function mutePlayer(targetId, minutes){
 if(!activeRoom || !isRoomOwner)return;
 try{
  const r=await fetch("/api/moderation",{
   method:"POST",headers:{"Content-Type":"application/json"},
   body:JSON.stringify({room:activeRoom,ownerId:sessionID,targetId,minutes})
  });
  if(r.ok){
   selectedMuteSender=null;
   await loadMutes();
   await refresh();
  }else{
   const msg=await r.text();
   alert(msg||"Stummschalten fehlgeschlagen.");
  }
 }catch(e){
  alert("Fehler beim Stummschalten.");
 }
}

async function loadMutes(){
 if(!activeRoom)return;
 const overview=document.getElementById("muteOverview");
 if(!isRoomOwner){
  if(overview)overview.hidden=true;
  return;
 }
 try{
  const list=await fetch("/api/moderation?room="+encodeURIComponent(activeRoom)).then(r=>r.json());
  if(!list.length){
   overview.hidden=true;
   overview.textContent="";
   return;
  }
  overview.hidden=false;
  overview.textContent="Stummgeschaltet: " + list.map(m=>(m.name||"Spieler")+" ("+m.seconds+"s)").join(", ");
 }catch(e){}
}

let tttLaunched=false;
let currentTTTGame=null;
let vgLaunched=false;
let currentVGGame=null;
let dameLaunched=false;
let currentDameGame=null;
let selectedGamePlayer=null;

const SUPPORTED_GAMES = [
 { id: "tictactoe", name: "Neon Tic Tac Toe", path: "/spiele/tictac/tictactoe.html", api: "/api/tictactoe" },
 { id: "viergewinnt", name: "Vier gewinnt", path: "/spiele/viergewinnt/viergewinnt.html", api: "/api/viergewinnt" },
 { id: "dame", name: "Dame", path: "/spiele/dame/dame.html", api: "/api/dame" }
];

function tttStatus(text){
 document.getElementById("game-status").textContent=text;
}

async function gameApiAction(gameId, action, data={}){
 const gameDef = SUPPORTED_GAMES.find(g=>g.id===gameId);
 if(!gameDef) return false;
 const response = await fetch(gameDef.api+"?room="+encodeURIComponent(activeRoom)+"&action="+encodeURIComponent(action),{
  method:"POST",headers:{"Content-Type":"application/json"},
  body:JSON.stringify({id:sessionID,...data})
 });
 if(!response.ok){
  const detail=(await response.text()).trim();
  tttStatus(detail||"Die Spielaktion ist fehlgeschlagen.");
  return false;
 }
 return true;
}

async function tttAction(action,data={}){
 return gameApiAction("tictactoe", action, data);
}

async function vgAction(action,data={}){
 return gameApiAction("viergewinnt", action, data);
}

async function dameAction(action,data={}){
 return gameApiAction("dame", action, data);
}

async function inviteGame(gameId, player){
 const gameDef = SUPPORTED_GAMES.find(g=>g.id===gameId);
 if(!gameDef) return;
 if(await gameApiAction(gameId, "invite", {toId: player.id})){
  selectedGamePlayer = null;
  tttStatus("Einladung zu "+gameDef.name+" an "+player.name+" wurde im Chat gesendet. Wir warten auf die Antwort …");
  await refreshPlayers();
  await refresh();
 }
}

async function inviteTicTacToe(player){
 return inviteGame("tictactoe", player);
}

async function inviteVierGewinnt(player){
 return inviteGame("viergewinnt", player);
}


 await refreshTicTacToe(players);
 await refreshVierGewinnt(players);
 await refreshDame(players);
}

async function refreshDame(players){
 let game=null;
 try{
  const response=await fetch("/api/dame?room="+encodeURIComponent(activeRoom)+"&id="+encodeURIComponent(sessionID));
  if(!response.ok)throw Error();
  game=(await response.json()).game;
 }catch(e){
  return;
 }

 currentDameGame=game;

 if(game && game.status==="active"){
  if(game.redId===sessionID || game.blueId===sessionID){
   tttStatus("Die Einladung zu Dame wurde angenommen. Das Spiel wird geöffnet …");
   if(!dameLaunched){
    dameLaunched=true;
    location.href="/spiele/dame/dame.html?room="+encodeURIComponent(activeRoom)+"&name="+encodeURIComponent(playerName());
   }
  }else{
   tttStatus(game.redName+" spielt gerade Dame gegen "+game.blueName+".");
  }
  return;
 }

 if(game && game.status==="invited"){
  if(game.redId===sessionID){
   tttStatus("Deine Einladung an "+game.blueName+" zu Dame steht im Chat. Wir warten auf die Antwort …");
  }else if(game.blueId===sessionID){
   tttStatus(game.redName+" hat dich zu Dame eingeladen. Du kannst direkt im Chat antworten.");
  }
  return;
 }
}

function renderGamePicker(players){
 const box=document.getElementById("gameplayers");
 box.innerHTML="";
 const others=players.filter(p=>p.id!==sessionID);

 if(!others.length){
  selectedGamePlayer=null;
  const empty=document.createElement("div");
  empty.className="empty";
  empty.textContent="Warte, bis ein weiterer Spieler dem Spielraum beitritt.";
  box.appendChild(empty);
  return;
 }

 if(selectedGamePlayer && !others.some(p=>p.id===selectedGamePlayer.id)){
  selectedGamePlayer=null;
 }

 others.forEach(p=>{
  const row=document.createElement("div");
  row.className="game-player";
  const name=document.createElement("span");
  name.textContent=p.name;
  const button=document.createElement("button");
  button.textContent=selectedGamePlayer && selectedGamePlayer.id===p.id?"Ausgewählt":"Spieler auswählen";
  button.onclick=()=>{
   selectedGamePlayer=p;
   renderGamePicker(players);
  };
  row.append(name,button);
  box.appendChild(row);
 });

 if(selectedGamePlayer){
  const controls=document.createElement("div");
  controls.className="game-invite-controls";

  const select=document.createElement("select");
  select.setAttribute("aria-label","Spiel auswählen");
  SUPPORTED_GAMES.forEach(g=>{
   const opt=document.createElement("option");
   opt.value=g.id;
   opt.textContent=g.name;
   select.appendChild(opt);
  });

  const invite=document.createElement("button");
  invite.textContent="Einladung senden";
  invite.onclick=async()=>{
   await inviteGame(select.value, selectedGamePlayer);
  };

  controls.append(select,invite);
  box.appendChild(controls);
 }
}

async function inviteTicTacToe(player){
 if(await tttAction("invite",{toId:player.id})){
  selectedGamePlayer=null;
  tttStatus("Einladung an "+player.name+" wurde im Chat gesendet. Wir warten auf die Antwort …");
  await refreshPlayers();
  await refresh();
 }
}

async function inviteVierGewinnt(player){
 if(await vgAction("invite",{toId:player.id})){
  selectedGamePlayer=null;
  tttStatus("Einladung zu Vier gewinnt an "+player.name+" wurde im Chat gesendet. Wir warten auf die Antwort …");
  await refreshPlayers();
  await refresh();
 }
}


 await refreshTicTacToe(players);
 await refreshVierGewinnt(players);
}

async function refreshVierGewinnt(players){
 let game=null;
 try{
  const response=await fetch("/api/viergewinnt?room="+encodeURIComponent(activeRoom)+"&id="+encodeURIComponent(sessionID));
  if(!response.ok)throw Error();
  game=(await response.json()).game;
 }catch(e){
  return;
 }

 currentVGGame=game;

 if(game && game.status==="active"){
  if(game.redId===sessionID || game.blueId===sessionID){
   tttStatus("Die Einladung zu Vier gewinnt wurde angenommen. Das Spiel wird geöffnet …");
   if(!vgLaunched){
    vgLaunched=true;
    location.href="/spiele/viergewinnt/viergewinnt.html?room="+encodeURIComponent(activeRoom)+"&name="+encodeURIComponent(playerName());
   }
  }else{
   tttStatus(game.redName+" spielt gerade Vier gewinnt gegen "+game.blueName+".");
  }
  return;
 }

 if(game && game.status==="invited"){
  if(game.redId===sessionID){
   tttStatus("Deine Einladung an "+game.blueName+" zu Vier gewinnt steht im Chat. Wir warten auf die Antwort …");
  }else if(game.blueId===sessionID){
   tttStatus(game.redName+" hat dich zu Vier gewinnt eingeladen. Du kannst direkt im Chat antworten.");
  }
  return;
 }
}

async function refreshTicTacToe(players){
 let game=null;
 try{
  const response=await fetch("/api/tictactoe?room="+encodeURIComponent(activeRoom)+"&id="+encodeURIComponent(sessionID));
  if(!response.ok)throw Error();
  game=(await response.json()).game;
 }catch(e){
  tttStatus("Tic Tac Toe konnte gerade nicht abgefragt werden.");
  return;
 }

 currentTTTGame=game;

 if(game && game.status==="active"){
  if(game.xId===sessionID || game.oId===sessionID){
   tttStatus("Die Einladung wurde angenommen. Tic Tac Toe wird geöffnet …");
   if(!tttLaunched){
    tttLaunched=true;
    location.href="/spiele/tictac/tictactoe.html?room="+encodeURIComponent(activeRoom)+"&name="+encodeURIComponent(playerName());
   }
  }else{
   tttStatus(game.xName+" spielt gerade gegen "+game.oName+".");
  }
  return;
 }

 if(game && game.status==="invited"){
  if(game.xId===sessionID){
   tttStatus("Deine Einladung an "+game.oName+" steht im Chat. Wir warten auf die Antwort …");
  }else if(game.oId===sessionID){
   tttStatus(game.xName+" hat dich zu Neon Tic Tac Toe eingeladen. Du kannst direkt im Chat antworten.");
  }else{
   tttStatus(game.xName+" hat "+game.oName+" zu Tic Tac Toe eingeladen.");
  }
  return;
 }

 if(game && game.status==="declined"){
  if(game.xId===sessionID){
   tttStatus(game.oName+" hat die Einladung abgelehnt. Du kannst jemand anderen auswählen.");
  }else if(game.oId===sessionID){
   tttStatus("Du hast die Einladung abgelehnt.");
  }else{
   tttStatus("Die letzte Spieleinladung wurde abgelehnt.");
  }
 }else if(game && game.status==="finished"){
  tttStatus("Die letzte Tic-Tac-Toe-Runde ist beendet. Du kannst eine neue Partie starten.");
 }else{
  tttStatus("Wähle einen Spieler aus und anschließend das gewünschte Spiel.");
 }

 renderGamePicker(players);
}
async function refresh(){
 if(!activeRoom)return;
 try{
  const r=await fetch("/api/messages?room="+encodeURIComponent(activeRoom)+"&id="+encodeURIComponent(sessionID));
  if(!r.ok){
   document.getElementById("roomstatus").textContent="Verbindung verloren";
   return;
  }
  const msgs=await r.json(),box=document.getElementById("chat");
  box.innerHTML="";
  msgs.forEach(m=>{
   const d=document.createElement("div");
   d.className="msg";

   if(m.gameInvite){
    d.className="msg game-invite";
    const title=document.createElement("strong");
    title.textContent=m.senderId===sessionID?"Deine Spieleinladung: ":m.name+" lädt dich ein: ";
    const gameDef = SUPPORTED_GAMES.find(g=>g.id===m.game) || { name: m.game||"Spiel", path: "/spiele/tictac/tictactoe.html" };
    const gameText=document.createElement("span");
    gameText.textContent=gameDef.name;
    const sm=document.createElement("small");
    sm.textContent="  "+m.time;
    d.append(title,gameText,sm);

    const game = (m.game==="dame") ? currentDameGame : (m.game==="viergewinnt") ? currentVGGame : currentTTTGame;
    if(game && game.id===m.gameId){
     const isInvitee = (m.game==="tictactoe") ? (m.toId===sessionID) : (game.blueId===sessionID);
     const isInviter = (m.game==="tictactoe") ? (game.xId===sessionID) : (game.redId===sessionID);
     if(game.status==="invited" && isInvitee){
      const actions=document.createElement("div");
      actions.className="game-invite-actions";

      const accept=document.createElement("button");
      accept.textContent="Einladung annehmen";
      accept.onclick=async()=>{
       if(await gameApiAction(m.game, "accept")){
        if(m.game==="dame") dameLaunched=true;
        else if(m.game==="viergewinnt") vgLaunched=true;
        else tttLaunched=true;
        location.href=gameDef.path+"?room="+encodeURIComponent(activeRoom)+"&name="+encodeURIComponent(playerName());
       }
      };

      const decline=document.createElement("button");
      decline.textContent="Ablehnen";
      decline.onclick=async()=>{
       if(await gameApiAction(m.game, "decline")){
        if(game) game.status="declined";
        tttStatus("Du hast die Einladung abgelehnt.");
        await refresh();
        refreshPlayers();
       }
      };

      actions.append(accept,decline);
      d.appendChild(actions);
     }else if(game.status==="declined"){
      const result=document.createElement("div");
      result.textContent=isInviter?"Einladung abgelehnt.":"Diese Einladung wurde abgelehnt.";
      d.appendChild(result);
     }else if(game.status==="active"){
      const result=document.createElement("div");
      result.textContent="Einladung angenommen. Das Spiel wird geöffnet.";
      d.appendChild(result);
     }
    }
   }else{
    const nameWrapper=document.createElement("span");
    if(isRoomOwner && m.senderId && m.senderId!==sessionID){
     const nameBtn=document.createElement("button");
     nameBtn.type="button";
     nameBtn.className="chat-name-btn";
     nameBtn.textContent=m.whisper ? (m.senderId===sessionID?"Du → "+m.toName:m.name+" → Du") : m.name;
     nameBtn.title="Klicken zum Stummschalten";
     nameBtn.onclick=(e)=>{
      e.stopPropagation();
      selectedMuteSender = (selectedMuteSender===m.senderId ? null : m.senderId);
      refresh();
     };
     nameWrapper.appendChild(nameBtn);
     const colon=document.createElement("span");
     colon.textContent=(m.whisper ? " (Flüstern): " : ": ");
     nameWrapper.appendChild(colon);
    }else{
     const b=document.createElement("b");
     if(m.whisper){
      b.textContent=(m.senderId===sessionID?"Du → "+m.toName:m.name+" → Du")+" (Flüstern): ";
     }else{
      b.textContent=m.name+": ";
     }
     nameWrapper.appendChild(b);
    }
    if(m.whisper){
     d.style.color="#ffd36a";
    }
    const t=document.createElement("span");
    t.textContent=m.text;
    const sm=document.createElement("small");
    sm.textContent="  "+m.time;
    d.append(nameWrapper,t,sm);

    if(isRoomOwner && selectedMuteSender===m.senderId){
     const pop=document.createElement("div");
     pop.className="mute-popover";
     const lbl=document.createElement("span");
     lbl.textContent="Stummschalten ("+m.name+"):";
     const b1=document.createElement("button");
     b1.textContent="1 Min";
     b1.onclick=()=>mutePlayer(m.senderId, 1);
     const b2=document.createElement("button");
     b2.textContent="2 Min";
     b2.onclick=()=>mutePlayer(m.senderId, 2);
     const b3=document.createElement("button");
     b3.textContent="3 Min";
     b3.onclick=()=>mutePlayer(m.senderId, 3);
     pop.append(lbl,b1,b2,b3);
     d.appendChild(pop);
    }
   }

   box.appendChild(d);
  });
  box.scrollTop=box.scrollHeight;
 }catch(e){}
}
async function send(){
 const field=document.getElementById("message"),text=field.value.trim();
 if(!text||!activeRoom)return;
 const r=await fetch("/api/messages?room="+encodeURIComponent(activeRoom),{
  method:"POST",headers:{"Content-Type":"application/json"},
  body:JSON.stringify({id:sessionID,name:playerName(),text,toId:document.getElementById("recipient").value})
 });
 if(r.ok){
  field.value="";
  refresh();
 }
}

document.getElementById("message").addEventListener("keydown",e=>{
 if(e.key==="Enter")send();
});

loadStatus();
refreshRooms();
setInterval(refreshRooms,3000);
setInterval(heartbeat,5000);
setInterval(refresh,1000);
setInterval(refreshPlayers,3000);
setInterval(loadMutes,3000);

const params=new URLSearchParams(location.search);
if(params.get("room")){
 document.getElementById("room").value=params.get("room");
 join();
}
</script>
</body>
</html>